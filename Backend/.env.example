# Tech Oracle Backend - Environment Variables Template

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Connection String
# Local development: mongodb://localhost:27017/
# Production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_URL=mongodb://localhost:27017/

# Database Name
DB_NAME=tech-oracle

# Collection Name
COLLECTION_NAME=repair_records

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret Key - CRITICAL: Change this in production!
# Generate with: openssl rand -hex 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Technician Password
# This is the password for the technician dashboard
TECHNICIAN_PASSWORD=your_secure_password_here

# Optional: Pre-hashed password (recommended for production)
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
# TECHNICIAN_PASSWORD_HASH=

# ============================================
# AI CONFIGURATION
# ============================================

# For Local Development (Ollama)
# No API key needed, just ensure Ollama is running locally
# Model will be: llama3

# For Production (Groq - Free Tier)
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Use Groq instead of Ollama (set to true for production)
USE_GROQ=false

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Production Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ============================================
# DEPLOYMENT SETTINGS (Optional)
# ============================================

# API Host (usually 0.0.0.0 for production)
# API_HOST=0.0.0.0

# API Port (set by platform in production)
# API_PORT=8000

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
