# MongoDB Connection String
# Format: mongodb://localhost:27017/ or mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_URL=mongodb://localhost:27017/

# MongoDB Database Name
DB_NAME=tech-oracle

# MongoDB Collection Name
COLLECTION_NAME=repair_records

# Ollama Model Configuration (optional, uses default if not set)
# OLLAMA_MODEL=llama3

# JWT Authentication
# Generate a secure random string for production: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
TECHNICIAN_PASSWORD=your_secure_password_here

# API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
